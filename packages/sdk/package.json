{
  "name": "anpord",
  "version": "0.1.3",
  "description": "TypeScript SDK and CLI for coding agent evals and prompt management.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./eval": {
      "import": {
        "types": "./dist/eval.d.mts",
        "default": "./dist/eval.mjs"
      },
      "require": {
        "types": "./dist/eval.d.cts",
        "default": "./dist/eval.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      }
    }
  },
  "keywords": [
    "anpord",
    "evals",
    "agents",
    "sandboxes",
    "prompts",
    "prompt-management",
    "versioning",
    "ai",
    "llm",
    "sdk",
    "cli"
  ],
  "homepage": "https://anpord.com",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "lint:publish": "publint --strict",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@anpord/schema": "workspace:*",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@anpord/template": "workspace:*",
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "esbuild": "^0.25.12",
    "effect": "^3.21.2"
  },
  "bin": {
    "anpord": "./dist/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlietlamb/anpord.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/charlietlamb/anpord/issues"
  }
}
