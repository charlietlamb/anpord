{
  "name": "@anpord/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./config": "./src/config.ts",
    "./describe": "./src/describe.ts",
    "./health": "./src/health.ts",
    "./test-database": "./src/test-database.ts",
    "./schema": "./src/schema.ts",
    "./schema/credentials/*": "./src/schema/credentials/*.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "bun scripts/generate.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:check": "bun scripts/check.ts",
    "db:reset": "bun scripts/reset.ts",
    "db:status": "bun scripts/status.ts"
  },
  "dependencies": {
    "@anpord/schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
