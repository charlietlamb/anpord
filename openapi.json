        "type": "object",
        "required": [
          "channel",
          "id",
          "version"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "description": "a string matching the pattern ^[a-z0-9][a-z0-9_-]*$",
            "title": "maxLength(36)",
