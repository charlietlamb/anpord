{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "files": {
    "includes": [
      "!apps/docs/openapi.json",
      "!spike",
      "!apps/mcp/mcp-env.d.ts",
      "!packages/ui/src/components/ui",
      "!context",
      "!packages/eval/tests/fixtures/case-files"
    ]
  },
  "linter": {
    "rules": {
      "correctness": { "useImportExtensions": "off" }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": { "useFilenamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/data-table/**"],
      "linter": {
        "rules": {
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": { "noUnresolvedImports": "off" }
        }
      }
    },
    {
      "includes": ["packages/db/src/schema.ts", "packages/sdk/src/index.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    }
  ]
}
