{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/docs": {
      "entry": ["style.css"],
      "project": []
    },
    "apps/e2e": {
      "entry": ["src/main.ts"],
      "project": ["src/**"]
    },
    "apps/worker": {
      "entry": ["trigger.config.ts", "src/trigger/**/*.ts"],
      "ignoreDependencies": ["trigger.dev"],
      "project": ["src/**", "trigger.config.ts"]
    },
    "apps/server": {
      "entry": ["src/server.ts", "tests/**/*.test.ts"],
      "project": ["src/**", "tests/**"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/server.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/components/dev/eval-fixtures.ts",
        "vite.config.ts"
      ],
      "project": "src/**",
      "ignore": ["src/routeTree.gen.ts"]
    },
    "packages/auth": {
      "entry": [
        "src/auth.ts",
        "src/config/auth-config.ts",
        "src/credentials/api-key-prefix.ts",
        "src/oauth/oauth-client-lookup.ts",
        "src/organization/organization-store.ts",
        "src/session/cookies.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**", "tests/**"]
    },
    "packages/cache": {
      "entry": ["src/cache.ts", "src/config.ts", "src/layer.ts"],
      "project": "src/**"
    },
    "packages/db": {
      "entry": [
        "src/client.ts",
        "src/config.ts",
        "src/schema.ts",
        "src/schema/**/*.ts"
      ],
      "project": "src/**"
    },
    "packages/eval": {
      "entry": [
        "src/adapters/sandbox/local.ts",
        "src/adapters/scorers/journal-assertions.ts",
        "src/domain/case-file.ts",
        "src/layer.ts",
        "src/sdk/define.ts",
        "src/sdk/evidence.ts",
        "src/sdk/outcome.ts",
        "src/sdk/report.ts",
        "src/sdk/scorers.ts",
        "src/sdk/variant.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**", "tests/**"]
    },
    "packages/ids": {
      "entry": ["src/id.ts", "src/layer.ts", "src/prefixes.ts"],
      "project": "src/**"
    },
    "packages/notifications": {
      "entry": [
        "src/email/email-config.ts",
        "src/email/email-sender.ts",
        "src/email/layer.ts",
        "src/email/magic-link-email.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**", "tests/**"]
    },
    "packages/prompts": {
      "entry": [
        "src/domain/errors.ts",
        "src/layer.ts",
        "src/services/channel-catalog.ts",
        "src/services/prompt-authoring.ts",
        "src/services/prompt-catalog.ts",
        "src/services/prompt-publishing.ts",
        "src/services/prompt-resolution.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**", "tests/**"]
    },
    "packages/schema": {
      "entry": [
        "src/domain/actor.ts",
        "src/domain/errors.ts",
        "src/domain/prompts.ts",
        "src/internal/api.ts",
        "src/internal/authentication.ts",
        "src/internal/health-api.ts",
        "src/internal/oauth-api.ts",
        "src/internal/prompts-api.ts",
        "src/public/api.ts",
        "src/public/authentication.ts",
        "src/public/client.ts",
        "src/public/prompts-api.ts",
        "src/public/requests.ts",
        "src/public/shapes.ts",
        "scripts/generate-openapi.ts"
      ],
      "project": "src/**"
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/cli/main.ts",
        "src/client/config.ts",
        "tests/**/*.test.ts",
        "tsdown.config.ts"
      ],
      "project": ["src/**", "tests/**"]
    },
    "packages/ui": {
      "entry": ["src/components/**/*.tsx"],
      "project": "src/**"
    }
  },
  "ignore": [
    "context/**",
    "scripts/server-workspace-deps.mjs",
    "autumn.config.ts"
  ],
  "ignoreBinaries": ["lsof"],
  "ignoreDependencies": [
    "@base-ui/react",
    "@biomejs/biome",
    "@phosphor-icons/react",
    "@tanstack/start-server-core",
    "class-variance-authority",
    "atmn"
  ],
  "rules": {
    "catalog": "off"
  }
}
