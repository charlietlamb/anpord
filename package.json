  "resolutions": {
    "@shikijs/core": "4.4.3",
    "@shikijs/transformers": "4.4.3",
    "@shikijs/twoslash": "4.4.3",
    "@shikijs/types": "4.4.3",
    "shiki": "4.4.3"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check:comments": "bun run scripts/check-comments.ts",
    "copy-connection": "bun run scripts/copy-connection.ts",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:studio": "bun --cwd packages/db db:studio",
    "dev": "turbo dev --continue=always",
    "dev:kill": "lsof -ti:3003,3005 | xargs kill 2>/dev/null || true",
    "docs": "bun --cwd apps/docs preview",
    "doctor": "react-doctor --yes",
    "e2e": "bun --filter @anpord/e2e e2e",
    "e2e:smoke": "bash scripts/e2e-v1.sh",
    "fix": "ultracite fix",
    "knip": "knip --no-config-hints",
    "mint-key": "bun run scripts/mint-api-key.ts",
    "og": "bun run scripts/generate-og-image.ts",
    "openapi": "bun run packages/schema/scripts/generate-openapi.ts",
    "prepare": "husky",
    "start": "bun --cwd apps/web start",
    "start:server": "bun --cwd apps/server start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "atmn": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "pg": "catalog:",
    "react-doctor": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  }
}
