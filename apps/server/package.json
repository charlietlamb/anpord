{
  "name": "@anpord/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch run src/server.ts",
    "build": "tsc --project tsconfig.json --noEmit",
    "start": "bun --env-file=../../.env run src/server.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@anpord/auth": "workspace:*",
    "@anpord/billing": "workspace:*",
    "@anpord/cache": "workspace:*",
    "@anpord/db": "workspace:*",
    "@anpord/eval": "workspace:*",
    "@anpord/ids": "workspace:*",
    "@anpord/notifications": "workspace:*",
    "@anpord/prompts": "workspace:*",
    "@anpord/schema": "workspace:*",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
