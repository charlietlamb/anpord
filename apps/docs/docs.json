{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Anpord",
  "description": "Evals for coding agents",
  "colors": {
    "primary": "#008aaf",
    "light": "#0097bc",
    "dark": "#0a0a0c"
  },
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "fonts": {
    "heading": {
      "family": "Funnel Display",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.anpord.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Fundamentals",
            "pages": [
              "introduction",
              "connections",
              "concepts",
              "evals/variants",
              "evals/results",
              "evals/baselines"
            ]
          },
          {
            "group": "Workflows",
            "pages": ["guides/claude-code", "guides/ci"]
          },
          {
            "group": "Advanced evals",
            "pages": ["evals/profiles", "evals/command-harness", "evals/import"]
          },
          {
            "group": "Tools",
            "pages": ["tools/cli", "tools/mcp"]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting"]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["sdk/overview", "getting-started"]
          },
          {
            "group": "Define evals",
            "pages": [
              "evals/cases",
              "evals/mocks",
              "evals/api-mocks",
              "evals/judges"
            ]
          },
          {
            "group": "Run evals",
            "pages": ["guides/run-from-code", "sdk/client"]
          },
          {
            "group": "Prompts",
            "pages": [
              "prompts/overview",
              "guides/resolving-prompts",
              "variables",
              "freshness"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/tools/sdk",
      "destination": "/sdk/client",
      "permanent": true
    },
    {
      "source": "/evals/mock-mcp",
      "destination": "/evals/mocks",
      "permanent": true
    },
    {
      "source": "/evals/mock-cli",
      "destination": "/evals/mocks",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/getting-started",
      "permanent": true
    },
    {
      "source": "/evals/harnesses",
      "destination": "/evals/variants",
      "permanent": true
    },
    {
      "source": "/guides/publishing",
      "destination": "/prompts/overview",
      "permanent": true
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/charlietlamb/anpord"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.anpord.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/charlietlamb/anpord"
    }
  }
}
