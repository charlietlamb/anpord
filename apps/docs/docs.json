{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Anpord",
  "description": "Prompt management for AI products",
  "colors": {
    "primary": "#008aaf",
    "light": "#0097bc",
    "dark": "#0a0a0c"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "fonts": {
    "heading": {
      "family": "Funnel Display",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.anpord.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["quickstart", "concepts"]
          },
          {
            "group": "Using prompts",
            "pages": ["guides/resolving-prompts", "guides/publishing"]
          },
          {
            "group": "Tools",
            "pages": ["tools/cli", "tools/mcp"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Reference",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Prompts",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/charlietlamb/anpord"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.anpord.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/charlietlamb/anpord"
    }
  }
}
