{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Anpord",
  "description": "Evals for coding agents",
  "colors": {
    "primary": "#008aaf",
    "light": "#0097bc",
    "dark": "#0a0a0c"
  },
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "fonts": {
    "heading": {
      "family": "Funnel Display",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.anpord.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["quickstart", "getting-started", "connections"]
          },
          {
            "group": "Evals",
            "pages": [
              "concepts",
              "evals/cases",
              "evals/import",
              "evals/variants",
              "evals/harnesses",
              "evals/profiles",
              "evals/command-harness",
              "evals/results",
              "evals/baselines"
            ]
          },
          {
            "group": "Guides",
            "pages": ["guides/run-from-code", "guides/ci"]
          },
          {
            "group": "Prompts",
            "pages": [
              "prompts/overview",
              "guides/resolving-prompts",
              "variables",
              "freshness",
              "guides/publishing"
            ]
          },
          {
            "group": "Tools",
            "pages": ["tools/sdk", "tools/cli", "tools/mcp"]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/charlietlamb/anpord"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.anpord.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/charlietlamb/anpord"
    }
  }
}
