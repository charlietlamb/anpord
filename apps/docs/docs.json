{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Anpord",
  "description": "Evals for coding agents",
  "colors": {
    "primary": "#008aaf",
    "light": "#0097bc",
    "dark": "#0a0a0c"
  },
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.anpord.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book",
        "groups": [
          {
            "group": "Fundamentals",
            "pages": [
              "introduction",
              "connections",
              "evals/variants",
              "evals/results"
            ]
          },
          {
            "group": "Workflows",
            "pages": ["guides/claude-code", "guides/ci"]
          },
          {
            "group": "Advanced evals",
            "pages": [
              "evals/profiles",
              "evals/command-harness",
              "evals/local",
              "evals/import"
            ]
          },
          {
            "group": "Tools",
            "pages": ["tools/cli", "tools/mcp"]
          }
        ]
      },
      {
        "tab": "SDK",
        "icon": "code",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["getting-started"]
          },
          {
            "group": "Define evals",
            "pages": [
              "evals/cases",
              "evals/mocks",
              "evals/judges",
              "evals/conversations"
            ]
          },
          {
            "group": "Run evals",
            "pages": ["guides/run-from-code", "sdk/client"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "rectangle-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/tools/sdk",
      "destination": "/sdk/client",
      "permanent": true
    },
    {
      "source": "/evals/mock-mcp",
      "destination": "/evals/mocks",
      "permanent": true
    },
    {
      "source": "/evals/mock-cli",
      "destination": "/evals/mocks",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/getting-started",
      "permanent": true
    },
    {
      "source": "/evals/harnesses",
      "destination": "/evals/variants",
      "permanent": true
    },
    {
      "source": "/evals/api-mocks",
      "destination": "/evals/mocks",
      "permanent": true
    },
    {
      "source": "/sdk/overview",
      "destination": "/getting-started",
      "permanent": true
    },
    {
      "source": "/evals/classifiers",
      "destination": "/evals/judges",
      "permanent": true
    }
  ],
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/charlietlamb/anpord"
    },
    "links": [
      {
        "label": "Dashboard",
        "href": "https://www.anpord.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/charlietlamb/anpord"
    }
  }
}
