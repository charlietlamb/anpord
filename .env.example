DATABASE_URL=postgresql://user:password@host.neon.tech/anpord?sslmode=verify-full
DATABASE_POOL_MAX=8

# Prompt cache. Unset to read straight from Postgres.
REDIS_URL=
CACHE_TTL_SECONDS=60

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3003
AUTH_SERVER_URL=http://127.0.0.1:3003
AUTH_TRUSTED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
WEB_URL=http://localhost:3005

HOST=127.0.0.1
PORT=3003

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic-link email. Unset RESEND_API_KEY to log links to the server console.
RESEND_API_KEY=
EMAIL_FROM=Anpord <noreply@anpord.dev>
